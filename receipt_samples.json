{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baza Próbek Paragonów Kaucyjnych - Ekosystem YIN",
  "description": "Zestawienie przebadanych kodów kreskowych z butelkomatów i kas, służące do inżynierii wstecznej struktury danych (kwota, data, sklep, butelkomat) bez konieczności używania OCR.",
  "version": "1.1.0",
  "patterns": {
    "biedronka_rvm_code128_28": {
      "name": "Biedronka Recyklomat (Code 128 - 28 cyfr)",
      "regex": "^9841(?<storeId>\\d{5})(?<terminalId>\\d{4})(?<timestamp>\\d{10})(?<amountUnits>\\d{4})(?<checkDigit>\\d{1})$",
      "fields": {
        "prefix": {
          "indices": [0, 4],
          "example": "9841",
          "description": "Prefiks GS1 kuponu zwrotnego / kaucji Biedronka (Jeronimo Martins)"
        },
        "storeId": {
          "indices": [4, 9],
          "example": "24327",
          "description": "5-cyfrowy identyfikator sklepu (np. Biedronka nr 01614 lub 24327 Zielonka)"
        },
        "terminalId": {
          "indices": [9, 13],
          "example": "2171",
          "description": "Identyfikator recyklomatu / kasy lub numer transakcji (np. 5531 lub 2171)"
        },
        "timestamp": {
          "indices": [13, 23],
          "example": "1789906816",
          "description": "10-cyfrowy Unix Timestamp z dokładnością do 1 sekundy (np. 1789906816 = 2026-09-20 12:20:16 UTC)"
        },
        "amountUnits": {
          "indices": [23, 27],
          "example": "0005",
          "description": "Wartość kaucji w jednostkach 10 groszy (0.10 zł). 0005 = 5 * 0.10 zł = 0.50 zł; 0065 = 65 * 0.10 zł = 6.50 zł"
        },
        "checkDigit": {
          "indices": [27, 28],
          "example": "5",
          "description": "Cyfra kontrolna GS1 Modulo 10 wyliczana z pierwszych 27 cyfr z wagami naprzemiennymi 3 i 1 (od prawej do lewej)"
        }
      }
    },
    "lidl_rvm_code128_24": {
      "name": "Lidl Butelkomat Standard (Code 128 - 24 cyfry)",
      "regex": "^2010(?<nonDepositGrosze>\\d{4})20(?<depositGrosze>\\d{4})(?<storeId>\\d{4})(?<ticketId>\\d{6})$",
      "fields": {
        "prefix": {
          "indices": [0, 4],
          "example": "2010",
          "description": "Prefiks bonu wewnętrznego Lidl (20) + znacznik opakowań bez kaucji (10)"
        },
        "nonDepositGrosze": {
          "indices": [4, 8],
          "example": "0500",
          "description": "Kwota za opakowania bez kaucji (zbiórka / eko po 10 gr) w groszach (0500 = 5.00 zł)"
        },
        "depositSeparator": {
          "indices": [8, 10],
          "example": "20",
          "description": "Znacznik kaucji ustawowej (20)"
        },
        "depositGrosze": {
          "indices": [10, 14],
          "example": "0450",
          "description": "Właściwa kaucja ustawowa w groszach (0450 = 4.50 zł; 50 gr za sztukę)"
        },
        "storeId": {
          "indices": [14, 18],
          "example": "1944",
          "description": "4-cyfrowy numer sklepu Lidl"
        },
        "ticketId": {
          "indices": [18, 24],
          "example": "111416",
          "description": "6-cyfrowy numer kolejny transakcji/wydruku butelkomatu"
        }
      }
    },
    "lidl_rvm_legacy_19": {
      "name": "Lidl / Tomra Format Pilotażowy 2025 (19 cyfr)",
      "regex": "^200(?<storeId>\\d{4})(?<ticketId>\\d{6})(?<amountGrosze>\\d{6})$",
      "fields": {
        "prefix": {
          "indices": [0, 3],
          "example": "200",
          "description": "Prefiks testowy kuponu"
        },
        "storeId": {
          "indices": [3, 7],
          "example": "1173",
          "description": "4-cyfrowy numer sklepu"
        },
        "ticketId": {
          "indices": [7, 13],
          "example": "100505",
          "description": "6-cyfrowy numer transakcji"
        },
        "amountGrosze": {
          "indices": [13, 19],
          "example": "000050",
          "description": "Kwota w groszach (000050 = 50 groszy = 0.50 zł)"
        }
      }
    }
  },
